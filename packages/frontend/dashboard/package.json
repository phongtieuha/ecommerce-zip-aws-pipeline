{
  "name": "@filepipeline/dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "tsc --noEmit && vite build",
    "build:deploy": "bun run scripts/build-for-deploy.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync:env": "bun run scripts/sync-env-from-cdk.ts",
    "deploy:s3": "bun run sync:env && bun run build:deploy && bun run --env-file=.env scripts/deploy-to-s3.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.120.5",
    "@tanstack/react-virtual": "^3.14.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.511.0",
    "luxon": "^3.7.2",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-countup": "^6.5.3",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.3.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@tanstack/router-devtools": "^1.120.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
