# Processor validation flags (CDK deploy-time)
ENABLE_FEATURE1_VALIDATION=false
ENABLE_FEATURE1_ERROR_REPORT=true
ENABLE_FEATURE2_VALIDATION=false
ENABLE_FEATURE2_ERROR_REPORT=true

# Dashboard Auth (CDK deploy-time)
# Comma-separated lists for allowed callback/logout URLs and SPA origins.
DASHBOARD_AUTH_CALLBACK_URLS=http://localhost:5173/,https://d34ua8bgtukrz7.cloudfront.net/dashboard/
DASHBOARD_AUTH_LOGOUT_URLS=http://localhost:5173/,https://d34ua8bgtukrz7.cloudfront.net/dashboard/
DASHBOARD_API_ALLOWED_ORIGINS=http://localhost:5173,https://d34ua8bgtukrz7.cloudfront.net

# Optional seed user for Cognito (leave blank to skip)
DASHBOARD_SEED_USER_EMAIL=
DASHBOARD_SEED_USER_PASSWORD=