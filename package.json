{
  "name": "filepipeline",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/frontend/*",
    "tools/*"
  ],
  "scripts": {
    "setup:localstack": "bun run --env-file=.env scripts/setup-localstack.ts",
    "dev": "bun run --filter '*' dev",
    "dev:lambda": "bun run --filter @filepipeline/lambda dev",
    "dev:lambda:restart": "bash ./scripts/restart-local-runner.sh",
    "dev:data-quality": "bun run --filter @filepipeline/lambda dev:data-quality",
    "dev:coordinator": "bun run --filter @filepipeline/lambda dev:coordinator",
    "dev:zip-checker": "bun run --filter @filepipeline/lambda dev:zip-checker",
    "dev:dashboard": "bun run --filter @filepipeline/dashboard dev",
    "dev:s3manager": "bash ./scripts/run-s3manager.sh",
    "build": "bun run --filter '*' build",
    "build:lambda": "bun run --filter @filepipeline/lambda build:aws",
    "build:dashboard": "bun run --filter @filepipeline/dashboard build",
    "upload:local:test": "bun run --env-file=.env scripts/seed-test-data.ts",
    "query:local:dynamodb": "bun run --env-file=.env scripts/query-dynamodb.ts",
    "csv:excel": "bun run --filter @filepipeline/csv-to-excel start --",
    "parser": "bun run --filter @filepipeline/parser start --",
    "create:aws:sendgrid-secret": "AWS_PROFILE=filepipeline bun run --env-file=.env.prod scripts/create-sendgrid-secret.ts",
    "deploy:aws": "AWS_PROFILE=filepipeline bun run --env-file=.env.prod scripts/deploy.ts",
    "deploy:aws:dashboard": "AWS_PROFILE=filepipeline bun run --filter @filepipeline/dashboard deploy:s3",
    "typecheck": "bun run --filter '*' typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "teardown:aws": "AWS_PROFILE=filepipeline bun run scripts/teardown.ts",
    "teardown:localstack": "bun run scripts/teardown-localstack.ts",
    "clean": "rm -rf packages/*/dist packages/*/dist-aws tools/*/dist node_modules/.cache"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "prettier": "^3.8.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.540.0",
    "@aws-sdk/client-lambda": "^3.540.0",
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/client-secrets-manager": "^3.540.0",
    "@aws-sdk/client-sqs": "^3.540.0",
    "@aws-sdk/lib-dynamodb": "^3.540.0",
    "@aws-sdk/util-dynamodb": "^3.540.0",
    "@types/node": "^25.9.3"
  }
}
