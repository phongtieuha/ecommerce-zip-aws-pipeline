# AWS Region
AWS_REGION=ap-southeast-1

# Internal S3 bucket (where failed_processing files are generated)
SOURCE_BUCKET=filepipeline-processed
SOURCE_PREFIX=failed_processing

# External S3 bucket (destination for failed processing files)
DESTINATION_BUCKET=
DESTINATION_PREFIX=failed_processing

# External AWS credentials for destination bucket
EXTERNAL_AWS_REGION=ap-southeast-1
EXTERNAL_AWS_ACCESS_KEY_ID=
EXTERNAL_AWS_SECRET_ACCESS_KEY=
