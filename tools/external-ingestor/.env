# AWS Region
AWS_REGION=ap-southeast-1

# Destination bucket (internal, where files will be copied to)
DESTINATION_BUCKET=filepipeline-incoming-682120331784-ap-southeast-1
DESTINATION_PREFIX=
# Set to true to write destination objects using EXTERNAL_AWS_* credentials
DESTINATION_USE_EXTERNAL_CREDS=false

# Allowed source buckets (optional, comma-separated)
# If empty, all source buckets are allowed
ALLOWED_SOURCE_BUCKETS=

# Cross-account AssumeRole (optional, for reading from cross-account AWS buckets)
# Example: arn:aws:iam::123456789012:role/ExternalBucketReadRole
SOURCE_ASSUME_ROLE_ARN=

# External Bucket Access (optional, for reading from external buckets with explicit access keys)
# Fill in these values to enable reading from an external bucket
EXTERNAL_BUCKET_NAME=data-source-input
EXTERNAL_AWS_REGION=ap-southeast-1
EXTERNAL_AWS_ACCESS_KEY_ID=
EXTERNAL_AWS_SECRET_ACCESS_KEY=
