# AWS / LocalStack
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# S3
INCOMING_BUCKET=filepipeline-incoming
PROCESSED_BUCKET=filepipeline-processed

# SQS
QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/filepipeline-queue
DLQ_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/filepipeline-dlq
DATA_QUALITY_QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/filepipeline-data-quality-queue
ZIP_CHECK_QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/filepipeline-zip-check-delay

# DynamoDB
DYNAMODB_TABLE=filepipeline-files
DATA_QUALITY_LOCK_TABLE=filepipeline-data-quality-locks
CONSOLIDATION_TABLE=filepipeline-consolidation

# Validation Flags
ENABLE_FEATURE1_VALIDATION=false
ENABLE_FEATURE1_ERROR_REPORT=true

ENABLE_FEATURE2_VALIDATION=false
ENABLE_FEATURE2_ERROR_REPORT=true