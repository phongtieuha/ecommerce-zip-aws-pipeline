{
  "vendor": "Lazada-Products",
  "pathExtraction": {
    "path": "data.mods.listItems || mods.listItems || data.products"
  },
  "columns": {
    "ads_ranking": {
      "source": "",
      "type": "number",
      "required": false,
      "min": 0
    },
    "avg_rating": {
      "source": "ratingScore",
      "type": "number",
      "required": false,
      "min": 0,
      "max": 5
    },
    "brand_id": {
      "source": "brandId",
      "type": "string",
      "required": false
    },
    "brand_name": {
      "source": "brandName",
      "type": "string",
      "required": false
    },
    "category_id": {
      "source": "categories[0] || categoryId",
      "type": "string",
      "required": true
    },
    "category_name": {
      "source": "",
      "type": "string",
      "required": false
    },
    "category_name_en": {
      "source": "",
      "type": "string",
      "required": false
    },
    "cnt_bonus_score": {
      "source": "",
      "type": "number",
      "required": false
    },
    "cnt_desc_score": {
      "source": "",
      "type": "number",
      "required": false
    },
    "cnt_img_score": {
      "source": "",
      "type": "number",
      "required": false
    },
    "cnt_title_score": {
      "source": "",
      "type": "number",
      "required": false
    },
    "cnt_total_score": {
      "source": "",
      "type": "number",
      "required": false
    },
    "cnt_vid_score": {
      "source": "",
      "type": "number",
      "required": false
    },
    "currency": {
      "source": "$root.data.mainInfo.currency || $root.mainInfo.currency",
      "type": "string",
      "required": true,
      "default": "$s3.country|currency"
    },
    "download_rank": {
      "source": "",
      "type": "number",
      "required": false
    },
    "hist_sold": {
      "source": "itemSoldCntShow|text_to_number || soldCount",
      "type": "number",
      "required": false,
      "min": 0
    },
    "image_urls": {
      "source": "thumbs|extract_field_to_array:image || imageUrl|split:,",
      "type": "array",
      "required": false,
      "default": []
    },
    "is_ad": {
      "source": "isAd",
      "type": "boolean",
      "required": false
    },
    "is_available": {
      "source": "inStock || isInStock",
      "type": "boolean",
      "required": true
    },
    "is_free_shipping": {
      "source": "hasFreeShipping",
      "type": "boolean",
      "required": false
    },
    "is_mart": {
      "source": "isLazMall",
      "type": "boolean",
      "required": false
    },
    "is_official_shop": {
      "source": "$lookup.Lazada.region.shop_id || $lookup.Lazada.region.shop_name",
      "type": "boolean",
      "required": false
    },
    "is_preferred_plus_seller": {
      "source": "isSponsored",
      "type": "boolean",
      "required": false
    },
    "keyword_priority": {
      "source": "",
      "type": "string",
      "required": false
    },
    "l1_category": {
      "source": "",
      "type": "string",
      "required": false,
      "default": "Beauty & Personal Care"
    },
    "l2_category": {
      "source": "",
      "type": "string",
      "required": false,
      "default": "Oral Care"
    },
    "l3_category": {
      "source": "",
      "type": "string",
      "required": false
    },
    "l4_category": {
      "source": "",
      "type": "string",
      "required": false
    },
    "liked_count": {
      "source": "",
      "type": "number",
      "required": false,
      "min": 0
    },
    "listed_on": {
      "source": "",
      "type": "string",
      "required": false
    },
    "manufacturer": {
      "source": "",
      "type": "string",
      "required": false
    },
    "num_bullets_update": {
      "source": "",
      "type": "number",
      "required": false,
      "default": 0
    },
    "num_images": {
      "source": "thumbs|extract_field_to_array:image|length || imageUrl|split:,|length",
      "type": "number",
      "required": false,
      "default": 0
    },
    "num_vid": {
      "source": "",
      "type": "number",
      "required": false,
      "default": 0
    },
    "organic_ranking": {
      "source": "",
      "type": "number",
      "required": false
    },
    "overall_ranking": {
      "source": "",
      "type": "number",
      "required": false
    },
    "platform": {
      "source": "$root.cube_metadata.channel|capitalize",
      "type": "string",
      "required": true,
      "default": "Lazada"
    },
    "sku_price_after_discount": {
      "source": "price",
      "type": "number",
      "required": false,
      "min": 0
    },
    "sku_price_before_discount": {
      "source": "originalPrice",
      "type": "number",
      "required": false,
      "min": 0
    },
    "price_max_after_discount": {
      "source": "price",
      "type": "number",
      "required": false,
      "min": 0
    },
    "price_max_before_discount": {
      "source": "originalPrice",
      "type": "number",
      "required": false,
      "min": 0
    },
    "price_min_after_discount": {
      "source": "price",
      "type": "number",
      "required": false,
      "min": 0
    },
    "price_min_before_discount": {
      "source": "originalPrice",
      "type": "number",
      "required": false,
      "min": 0
    },
    "product_desc": {
      "source": "",
      "type": "string",
      "required": false,
      "default": ""
    },
    "product_name": {
      "source": "name",
      "type": "string",
      "required": true
    },
    "product_url": {
      "source": "itemUrl || pageUrl",
      "type": "string",
      "required": true
    },
    "rating_count": {
      "source": "review",
      "type": "number",
      "required": false,
      "default": 0
    },
    "rating_count_with_context": {
      "source": "",
      "type": "number",
      "required": false,
      "min": 0
    },
    "rating_count_with_image": {
      "source": "",
      "type": "number",
      "required": false,
      "min": 0
    },
    "recorded_on": {
      "source": "$root.cube_metadata.snapshot_timestamp|date:YYYY-MM-DD || $dateFromFilename",
      "type": "string",
      "required": true
    },
    "region": {
      "source": "$root.cube_metadata.country",
      "type": "string",
      "required": true,
      "default": "$s3.country"
    },
    "review_count": {
      "source": "reviewCount",
      "type": "number",
      "required": false,
      "min": 0
    },
    "search_keyword": {
      "source": "",
      "type": "string",
      "required": false
    },
    "shop_id": {
      "source": "sellerId || $root.mainInfo.selectedFilters.shopId || $root.data.mainInfo.selectedFilters.shopId || shopId",
      "type": "string",
      "required": true
    },
    "shop_location": {
      "source": "location",
      "type": "string",
      "required": false,
      "default": "$root.cube_metadata.country"
    },
    "shop_name": {
      "source": "sellerName",
      "type": "string",
      "required": false
    },
    "sku_name": {
      "source": "",
      "type": "string",
      "required": false
    },
    "small_cat": {
      "source": "",
      "type": "string",
      "required": false
    },
    "source_product_id": {
      "source": "itemId",
      "type": "string",
      "required": true
    },
    "source_sku_id": {
      "source": "thumbs[0].skuId || skuId || defaultSkuId",
      "type": "string",
      "required": true
    },
    "stock": {
      "source": "inStock|boolean_to_stock || isInStock|boolean_to_stock",
      "type": "number",
      "required": false
    },
    "updated_num_words": {
      "source": "",
      "type": "number",
      "required": false,
      "default": 0
    },
    "video_urls": {
      "source": "",
      "type": "array",
      "required": false,
      "default": []
    },
    "word_count": {
      "source": "description|count_words",
      "type": "number",
      "required": false,
      "default": 0
    },
    "cleaned_product_desc": {
      "source": "",
      "type": "string",
      "required": false,
      "default": ""
    },
    "product_name_char_count": {
      "source": "name|length",
      "type": "number",
      "required": false,
      "default": 0
    },
    "product_desc_char_count": {
      "source": "description|clean_product_description|length",
      "type": "number",
      "required": false,
      "default": 0
    },
    "is_lorikeet": {
      "source": "description|contain_image|boolean_to_text",
      "type": "string",
      "required": false
    },
    "product_desc_images": {
      "source": "description|extract_product_desc_images",
      "type": "array",
      "required": false,
      "default": []
    }
  }
}
