    "scriptExpression": "(() => { const html = (typeof __html === 'string' ? __html : '') || (typeof window !== 'undefined' && typeof window.__html === 'string' ? window.__html : ''); if (!html) return []; const canonicalMatch = html.match(/<link href=\"https:\\/\\/allonline\\.7eleven\\.co\\.th\\/brands\\/supermarket\\/([^\\/\"?#]+)\\/?\" rel=\"canonical\"\\/?>/i) || html.match(/<form action=\"\\/brands\\/supermarket\\/([^\\/\"?#]+)\\//i); const shopId = canonicalMatch?.[1]?.trim() ?? ''; const shopNameMatch = html.match(/<h1 class=\"header-category\">[\\s\\S]*?([^<\\n]+)[\\s\\S]*?<span class=\"how-many\">/i) || html.match(/<li class=\"active\"[\\s\\S]*?<span property=\"name\">\\s*([^<]+?)\\s*<\\/span>/i); const shopName = shopNameMatch?.[1]?.replace(/\\s+/g, ' ').trim() ?? ''; const categoryMatch = html.match(/<a href=\"\\/brands\\/supermarket\\/\"[^>]*>[\\s\\S]*?<span property=\"name\">\\s*([^<]+?)\\s*<\\/span>/i); const category = categoryMatch?.[1]?.replace(/\\s+/g, ' ').trim() ?? 'Supermarket'; const cards = html.split('<div class=\"product-item ').slice(1); return cards.map((card) => { const linkMatch = card.match(/<a class=\"productlink\"[^>]*data-href=\"([^\"]+)\"[^>]*href=\"([^\"]+)\"[^>]*title=\"([^\"]+)\"/i); if (!linkMatch) return null; const dataHref = linkMatch[1].replace(/&amp;/g, '&'); const href = linkMatch[2].replace(/&amp;/g, '&'); const title = linkMatch[3].replace(/&amp;/g, '&').trim(); const descMatch = card.match(/<div class=\"item description item-description-cls-mobile\">\\s*([\\s\\S]*?)\\s*<\\/div>/i); const rawName = (descMatch?.[1] ?? title.split(' - ')[0] ?? '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim(); const currentPriceMatch = card.match(/<div class=\"price price-cls-mobile\">[\\s\\S]*?<strong>\\s*฿\\s*([0-9.,]+)\\s*<\\/strong>/i); const strikePriceMatch = card.match(/<div class=\"price price-cls-mobile\">[\\s\\S]*?<s>\\s*฿\\s*([0-9.,]+)\\s*<\\/s>/i); const resolvedPrice = (currentPriceMatch?.[1] ?? strikePriceMatch?.[1] ?? '').replace(/,/g, ''); const productIdMatch = dataHref.match(/\\/(\\d+)\\/(?:\\?[^#\"]*)?#itemId=/); const skuIdMatch = dataHref.match(/#itemId=([0-9_]+)/); const productId = productIdMatch?.[1] ?? ''; const skuId = skuIdMatch?.[1] ?? ''; const normalizedSkuId = (skuId || productId).replace(/_0$/, '010'); return { brand: shopName, category, id: skuId || productId, name: rawName, list: href.startsWith('http') ? href : `https://allonline.7eleven.co.th${href}`, price: resolvedPrice, is_official_shop: true, shop_id: shopId, shop_name: shopName, sku_name: rawName, sku_id_normalized: normalizedSkuId, source_product_id_enriched: productId }; }).filter(Boolean); })()"
