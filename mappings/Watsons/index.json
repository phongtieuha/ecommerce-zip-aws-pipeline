      "description": "Standard product detail page mapping with populated source fields"
    },
    {
      "id": "Watsons-Products",
      "name": "Watsons Products Schema",
      "file": "Watsons-Products.json",
      "description": "Products schema with empty source fields (template)"
    },
    {
      "id": "Watsons-Products-2",
      "name": "Watsons Products Schema v2",
      "file": "Watsons-Products-2.json",
      "description": "Feature 2"
    }
  ],
  "default": "Watsons-PDP-1",
  "selectionRules": [
    {
