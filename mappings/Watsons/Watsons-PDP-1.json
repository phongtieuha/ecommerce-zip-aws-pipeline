{
  "vendor": "Watsons-PDP-1",
  "pathExtraction": {
    "path": "data.cx-state.product.details.entities.$fileName"
  },
  "rowExpansion": {
    "arrayPath": "details.value.variants.value.baseOptions[0].options || details.value.baseOptions[0].options"
  },
  "columns": {
    "ads_ranking": {
      "source": "",
      "type": "number",
      "required": false,
      "min": 0
    },
    "avg_rating": {
      "source": "details.value.averageRating",
      "type": "number",
      "required": false,
      "min": 0,
      "max": 5
    },
    "brand_id": {
      "source": "details.value.masterBrand.code",
      "type": "string",
      "required": false
    },
    "brand_name": {
      "source": "details.value.masterBrand.name",
      "type": "string",
      "required": false
    },
    "category_id": {
      "source": "details.value.categoryNameLevels[0].code || details.value.categories[0].code",
      "type": "string",
      "required": true
    },
    "category_name": {
      "source": "details.value.categoryNameLevels[0].name || details.value.categories[0].name",
      "type": "string",
      "required": true
    },
    "category_name_en": {
      "source": "details.value.categoryNameLevels[0].gtmName || details.value.categories[0].gtmName",
      "type": "string",
      "required": false
    },
    "cnt_bonus_score": {
      "source": "",
      "type": "number",
      "required": false
    },
    "cnt_desc_score": {
      "source": "",
      "type": "number",
      "required": false
    },
    "cnt_img_score": {
      "source": "",
      "type": "number",
      "required": false
    },
    "cnt_title_score": {
      "source": "",
      "type": "number",
      "required": false
    },
    "cnt_total_score": {
      "source": "",
      "type": "number",
      "required": false
    },
    "cnt_vid_score": {
      "source": "",
      "type": "number",
      "required": false
    },
    "currency": {
      "source": "details.value.price.currencyIso",
      "type": "string",
      "required": true,
      "default": "$s3.country|currency"
    },
    "download_rank": {
      "source": "",
      "type": "number",
      "required": false
    },
    "hist_sold": {
      "source": "",
      "type": "number",
      "required": false,
      "min": 0
    },
    "image_urls": {
      "source": "details.value.images.GALLERY|extract_field_to_array:product|extract_field_to_array:url",
      "type": "array",
      "required": false,
      "default": []
    },
    "is_ad": {
      "source": "",
      "type": "boolean",
      "required": false
    },
    "is_available": {
      "source": "$expansion.stock.stockLevel|gt:0",
      "type": "boolean",
      "required": true
    },
    "is_free_shipping": {
      "source": "",
      "type": "boolean",
      "required": false
    },
    "is_mart": {
      "source": "",
      "type": "boolean",
      "required": false
    },
    "is_official_shop": {
      "source": "",
      "type": "boolean",
      "required": true,
      "default": true
    },
    "is_preferred_plus_seller": {
      "source": "",
      "type": "boolean",
      "required": false
    },
    "keyword_priority": {
      "source": "",
      "type": "string",
      "required": false
    },
    "l1_category": {
      "source": "",
      "type": "string",
      "required": false,
      "default": "Beauty & Personal Care"
    },
    "l2_category": {
      "source": "",
      "type": "string",
      "required": false,
      "default": "Oral Care"
    },
    "l3_category": {
      "source": "",
      "type": "string",
      "required": false
    },
    "l4_category": {
      "source": "",
      "type": "string",
      "required": false
    },
    "liked_count": {
      "source": "",
      "type": "number",
      "required": false,
      "min": 0
    },
    "listed_on": {
      "source": "",
      "type": "string",
      "required": false
    },
    "manufacturer": {
      "source": "",
      "type": "string",
      "required": false
    },
    "num_bullets_update": {
      "source": "details.value.description|count_bullets_clean",
      "type": "number",
      "required": false,
      "default": 0
    },
    "num_images": {
      "source": "details.value.images.GALLERY|extract_field_to_array:product|extract_field_to_array:url|length",
      "type": "number",
      "required": false,
      "default": 0
    },
    "num_vid": {
      "source": "details.value.videos.url|split:','|filter_empty_strings|length",
      "type": "number",
      "required": false,
      "default": 0
    },
    "organic_ranking": {
      "source": "",
      "type": "number",
      "required": false
    },
    "overall_ranking": {
      "source": "",
      "type": "number",
      "required": false
    },
    "platform": {
      "source": "",
      "type": "string",
      "required": true,
      "default": "Watsons"
    },
    "sku_price_after_discount": {
      "source": "details.value.elabMarkDownPrice.value",
      "type": "number",
      "required": false,
      "min": 0
    },
    "sku_price_before_discount": {
      "source": "$expansion.priceData.value",
      "type": "number",
      "required": false,
      "min": 0
    },
    "price_max_after_discount": {
      "source": "details.value.elabMarkDownPrice.value",
      "type": "number",
      "required": false,
      "min": 0
    },
    "price_max_before_discount": {
      "source": "$expansion.priceData.value",
      "type": "number",
      "required": false,
      "min": 0
    },
    "price_min_after_discount": {
      "source": "details.value.elabMarkDownPrice.value",
      "type": "number",
      "required": false,
      "min": 0
    },
    "price_min_before_discount": {
      "source": "$expansion.priceData.value",
      "type": "number",
      "required": false,
      "min": 0
    },
    "product_desc": {
      "source": "details.value.description",
      "type": "string",
      "required": false,
      "default": ""
    },
    "product_name": {
      "source": "details.value.name",
      "type": "string",
      "required": true
    },
    "product_url": {
      "source": "$expansion.url|mapurl:https://www.watsons.com.{country}/{value}",
      "type": "string",
      "required": true
    },
    "rating_count": {
      "source": "details.value.numberOfReviews",
      "type": "number",
      "required": false,
      "default": 0
    },
    "rating_count_with_context": {
      "source": "",
      "type": "number",
      "required": false,
      "min": 0
    },
    "rating_count_with_image": {
      "source": "",
      "type": "number",
      "required": false,
      "min": 0
    },
    "recorded_on": {
      "source": "$root.cube_metadata.snapshot_timestamp|date:YYYY-MM-DD",
      "type": "string",
      "required": true
    },
    "region": {
      "source": "$root.cube_metadata.country",
      "type": "string",
      "required": true,
      "default": "$s3.country"
    },
    "review_count": {
      "source": "details.value.review",
      "type": "number",
      "required": false,
      "min": 0
    },
    "search_keyword": {
      "source": "",
      "type": "string",
      "required": false
    },
    "shop_id": {
      "source": "details.value.masterBrand.code",
      "type": "string",
      "required": true
    },
    "shop_location": {
      "source": "",
      "type": "string",
      "required": false,
      "default": "$root.cube_metadata.country"
    },
    "shop_name": {
      "source": "details.value.masterBrand.name",
      "type": "string",
      "required": true
    },
    "sku_name": {
      "source": "details.value.gtmName",
      "type": "string",
      "required": true
    },
    "small_cat": {
      "source": "",
      "type": "string",
      "required": false
    },
    "source_product_id": {
      "source": "details.value.baseProduct",
      "type": "string",
      "required": true
    },
    "source_sku_id": {
      "source": "$expansion.code",
      "type": "string",
      "required": true
    },
    "stock": {
      "source": "$expansion.stock.stockLevel",
      "type": "number",
      "required": false
    },
    "updated_num_words": {
      "source": "details.value.description|count_words_no_bullet",
      "type": "number",
      "required": false,
      "default": 0
    },
    "video_urls": {
      "source": "details.value.videos.url|split:','|filter_empty_strings",
      "type": "array",
      "required": false,
      "default": []
    },
    "word_count": {
      "source": "details.value.description|count_words",
      "type": "number",
      "required": false,
      "default": 0
    },
    "cleaned_product_desc": {
      "source": "details.value.description|clean_product_description",
      "type": "string",
      "required": false,
      "default": ""
    },
    "product_name_char_count": {
      "source": "details.value.name|length",
      "type": "number",
      "required": false,
      "default": 0
    },
    "product_desc_char_count": {
      "source": "details.value.description|clean_product_description|length",
      "type": "number",
      "required": false,
      "default": 0
    },
    "is_lorikeet": {
      "source": "details.value.description|contain_image|boolean_to_text",
      "type": "string",
      "required": false
    },
    "product_desc_images": {
      "source": "details.value.description|extract_product_desc_images",
      "type": "array",
      "required": false,
      "default": []
    }
  }
}
